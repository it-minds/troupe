# Shell scripts are run by bash on every platform this project builds on — the Linux
# and macOS runners, the Windows runner's Git Bash, and a Linux container with the
# repository mounted from a Windows checkout. A `set -euo pipefail` with a carriage
# return on the end of it is not something bash accepts, and the error it gives
# ("invalid option name") says nothing about line endings. So these files are LF in
# the working tree as well as in the index, whatever `core.autocrlf` is set to.
*.sh text eol=lf
install.sh text eol=lf
scripts/build-images text eol=lf
scripts/build-local text eol=lf
scripts/dev-down text eol=lf
scripts/dev-up text eol=lf
scripts/kind-down text eol=lf
scripts/kind-up text eol=lf
scripts/pitr-drill text eol=lf
scripts/remote-up text eol=lf
scripts/toolbox text eol=lf
dev/toolbox/entrypoint text eol=lf
