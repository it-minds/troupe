@echo off
rem A laptop daemon is not a distributed node: no name, no epmd, no port beyond its own.
set RELEASE_DISTRIBUTION=none
rem `start --detached` (`troupe-daemon run --detached`, the login entry's) boots the VM on
rem detached.vm.args, vm.args with `-detached` after it: no console, so no window. The
rem release script reads RELEASE_VM_ARGS only after this file has run, and gives this file
rem the command line, which is what makes one command's flags possible here.
if "%~1"=="start" if "%~2"=="--detached" set "RELEASE_VM_ARGS=%~dp0detached.vm.args"
