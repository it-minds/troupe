{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    // The same resolution `vite.config.ts` uses, so `tsc` and Vite read one client.
    "paths": {
      "@troupe/client": ["../../packages/client/src/index.ts"]
    }
  },
  "include": [
    "src"
  ]
}
