{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "signCommand": {
        "cmd": "pwsh",
        "args": [
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../../../../../scripts/signing/sign-windows.ps1",
          "%1"
        ]
      }
    }
  }
}
