      "selected": {
        "dark": "#1E2C3C",
        "light": "#DCE6F2"
      },
      "scrim": {
        "dark": "rgba(4,7,11,0.68)",
        "light": "rgba(16,24,33,0.42)"
      },
      "shadow": {
        "dark": "#080C12",
        "light": "#DDE3EA",
        "description": "The one hard shadow: a flat block offset under a tile or a primary button. The stage colour, so it reads as depth rather than as a second colour."
      }
    },
