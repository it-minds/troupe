{
  "$meta": {
    "name": "Troupe — Footlight",
    "id": "footlight",
    "version": "1.0.0",
    "default": false,
    "description": "Ink navy, drafting blue-grey, one stage amber. The default theme: cool, quiet infrastructure with a single warm light in it.",
    "reservedColour": "status.waiting — stage amber #FFB43D / #B36A00. Means 'a person must decide' and nothing else.",
    "defaultMode": "dark"
  },
  "$themeContract": "Every colour token carries a dark and a light value under one semantic name. Components read the name, never a hex. All four Troupe themes expose exactly this token set — swapping a theme swaps values only. A theme that needs a new token name is a redesign, not a theme.",
  "color": {
    "bg": {
      "stage": {
        "dark": "#080C12",
        "light": "#DDE3EA"
      },
      "canvas": {
        "dark": "#0E141D",
        "light": "#EEF1F5"
      },
      "panel": {
        "dark": "#141C27",
        "light": "#F8FAFC"
      },
      "raised": {
        "dark": "#1B2532",
        "light": "#FFFFFF"
      },
      "sunken": {
        "dark": "#0A0F16",
        "light": "#E5EAF0"
      },
      "hover": {
        "dark": "#223040",
        "light": "#E2E9F1"
