{
  "$meta": {
    "name": "Troupe — Limelight",
    "id": "limelight",
    "version": "1.0.0",
    "default": false,
    "description": "Warm ink grounds — smoked oak and auditorium dark — with attention carried by limelight, the pale greenish-white of burning quicklime.",
    "reservedColour": "status.waiting — limelight #CBEA5C / #6E7F12. Always takes dark text when filled.",
    "defaultMode": "dark"
  },
