  "radius": {
    "none": "0px",
    "xs": "2px",
    "sm": "3px",
    "md": "5px",
    "lg": "8px",
    "pill": "999px",
    "$note": "Deliberately tight. Structure comes from hairlines and alignment, not rounding."
  },
  "border": {
    "hairline": "1px",
    "strong": "1.5px",
    "focus": "2px",
    "marker": "3px",
    "$note": "marker is the left edge that flags a row or panel as needing attention."
  },
  "motion": {
    "duration": {
      "instant": "0ms",
      "fast": "120ms",
      "base": "180ms",
      "slow": "300ms",
      "wake": "700ms",
      "pulse": "2200ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0.05, 0.7, 0.1, 1)",
      "exit": "cubic-bezier(0.3, 0, 0.8, 0.15)",
      "linear": "linear"
    },
    "rules": [
      "Every animation is idempotent: a server-driven DOM replacement may restart it at any time, and restarting must look acceptable.",
      "Nothing animates except a state genuinely in motion: running, waiting, reconnecting, waking.",
      "prefers-reduced-motion: reduce collapses all durations to instant and replaces pulses with static marks."
    ]
  },
  "breakpoint": {
    "min": {
      "value": "380px",
      "description": "Hard floor. Everything must work here."
    },
    "sm": {
      "value": "480px"
    },
    "md": {
      "value": "720px",
      "description": "Backstage becomes a side panel instead of a sheet."
    },
    "lg": {
      "value": "1040px",
      "description": "Session list rail appears beside the conversation."
    },
    "xl": {
      "value": "1320px",
      "description": "Reading column caps; backstage widens."
    }
  },
  "zIndex": {
    "base": 0,
    "raised": 10,
    "sticky": 100,
    "rail": 200,
    "approval": 300,
    "sheet": 400,
    "overlay": 500,
    "toast": 600
  },
  "size": {
    "touchTarget": {
      "value": "44px",
      "description": "Minimum hit area for anything tappable, approvals included."
    },
    "avatar": {
      "sm": "20px",
      "md": "26px",
      "lg": "34px"
    },
    "railWidth": "272px",
    "backstageWidth": "336px",
    "composerMinHeight": "52px",
    "switchTrack": {
      "value": "44px",
      "description": "Tool on/off switch track. Knob 18px, travel 18px."
    }
  },
  "mark": {
    "$note": "The mask. One silhouette, split down the middle: the filled half is what the agent did alone, the hollow half is what still needs a person.",
    "path": "M9 15 Q9 7 24 7 Q39 7 39 15 L39 25 Q39 35 24 43 Q9 35 9 25 Z",
    "viewBox": "0 0 48 48",
    "strokeWidth": {
      "lg": "2.6",
      "md": "3",
      "sm": "3.4"
    },
    "eyeLeft": "M15.5 21 Q19 18.4 22.5 21 Q19 23.6 15.5 21 Z",
    "eyeRight": "M25.5 21 Q29 18.4 32.5 21 Q29 23.6 25.5 21 Z",
    "seam": {
      "path": "M24 8 L24 42",
      "minSize": "32px",
      "description": "Drop the seam line below 32px and let the colour change be the seam."
    },
    "lightDirection": "right",
    "rules": [
      "Fill the mask with the surface behind it, never a colour outside the token set.",
      "No mouth, ever.",
      "An eye on a filled half is cut out of it; an eye on a hollow half is solid.",
      "People never get a mask. A human is initials in a ring."
    ]
  }
}
