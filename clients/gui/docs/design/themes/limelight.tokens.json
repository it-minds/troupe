  "shadow": {
    "none": "none",
    "raise": {
      "dark": "0 1px 2px rgba(0,0,0,0.55)",
      "light": "0 1px 2px rgba(24,20,12,0.10)",
      "use": "Menus and chips only."
    },
    "sheet": {
      "dark": "0 -8px 28px rgba(0,0,0,0.6)",
      "light": "0 -8px 28px rgba(24,20,12,0.16)",
      "use": "Bottom sheet and mobile backstage."
    },
    "overlay": {
      "dark": "0 16px 48px rgba(0,0,0,0.66)",
      "light": "0 16px 48px rgba(24,20,12,0.22)",
      "use": "Dialogs."
    },
    "footlight": {
      "dark": "0 -1px 0 #CBEA5C, 0 -14px 34px rgba(203,234,92,0.14)",
      "light": "0 -1px 0 #6E7F12, 0 -14px 34px rgba(110,127,18,0.13)",
      "use": "The approval panel only."
    }
  },
  "typography": {
    "family": {
      "sans": {
        "value": "'IBM Plex Sans','Segoe UI',system-ui,sans-serif",
        "description": "Interface and reading. Full Danish diacritic coverage at every weight."
      },
      "mono": {
        "value": "'IBM Plex Mono',ui-monospace,'SFMono-Regular',Menlo,monospace",
        "description": "Anything literal: paths, commands, diffs, identifiers, status words, the wordmark."
      }
    },
    "role": {
      "display": {
        "family": "sans",
        "size": "clamp(28px, 5vw, 40px)",
        "weight": 600,
        "lineHeight": 1.12,
        "letterSpacing": "-0.02em",
        "use": "Sign-in, single-purpose screens."
      },
      "title": {
        "family": "sans",
        "size": "clamp(21px, 3vw, 26px)",
        "weight": 600,
        "lineHeight": 1.2,
        "letterSpacing": "-0.015em",
        "use": "Screen title, session subject."
      },
      "heading": {
        "family": "sans",
        "size": "17px",
        "weight": 600,
        "lineHeight": 1.35,
        "letterSpacing": "-0.008em",
        "use": "Panel headings, approval headline."
      },
      "subheading": {
        "family": "sans",
        "size": "15px",
        "weight": 600,
        "lineHeight": 1.4,
        "letterSpacing": "0",
        "use": "Group headings, list section labels."
      },
      "body": {
        "family": "sans",
        "size": "15px",
        "weight": 400,
        "lineHeight": 1.62,
        "letterSpacing": "0.002em",
        "use": "Conversation and all long-form reading."
      },
      "bodyStrong": {
        "family": "sans",
        "size": "15px",
        "weight": 600,
        "lineHeight": 1.62,
        "letterSpacing": "0.002em",
        "use": "Emphasis inside body copy."
      },
      "ui": {
        "family": "sans",
        "size": "14px",
        "weight": 500,
        "lineHeight": 1.4,
        "letterSpacing": "0.004em",
        "use": "Buttons, tabs, inputs, list rows."
      },
      "uiSmall": {
        "family": "sans",
        "size": "13px",
        "weight": 500,
        "lineHeight": 1.4,
        "letterSpacing": "0.006em",
        "use": "Secondary controls, chips, metadata."
      },
      "micro": {
        "family": "mono",
        "size": "11.5px",
        "weight": 500,
        "lineHeight": 1.3,
        "letterSpacing": "0.04em",
        "use": "Status pills, counts, relative times. Sentence case, never all caps."
      },
      "code": {
        "family": "mono",
        "size": "13px",
        "weight": 400,
        "lineHeight": 1.55,
        "letterSpacing": "0",
        "use": "Commands, file paths, inline code."
      },
      "codeSmall": {
        "family": "mono",
        "size": "12px",
        "weight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0",
        "use": "Diff bodies and dense log output."
      },
      "wordmark": {
        "family": "mono",
        "size": "32px",
        "weight": 600,
        "lineHeight": 1,
        "letterSpacing": "-0.01em",
        "use": "The word 'troupe'. Always lowercase."
      }
    },
    "measure": {
      "reading": {
        "value": "68ch",
        "description": "Max line length for agent output and long copy."
      },
      "narrow": {
        "value": "46ch",
        "description": "Empty states, sign-in, error copy."
      }
    }
  },
