    "accent": {
      "dark": "#7FB6F5",
      "light": "#14568F",
      "description": "The brand where it is not a status: the current nav item's edge. The link blue, because the reserved colour here means waiting and nothing else."
    },
    "border": {
      "hairline": {
        "dark": "#252A31",
        "light": "#C8CCD2"
      },
      "strong": {
        "dark": "#3A424C",
        "light": "#979EA7"
      },
