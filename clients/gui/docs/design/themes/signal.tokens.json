{
  "$meta": {
    "name": "Troupe — Signal",
    "id": "signal",
    "version": "1.0.0",
    "default": true,
    "description": "Neutral graphite with no blue cast, and a printer's duotone on top: cyan is the machine working, magenta is you being asked.",
    "reservedColour": "status.waiting — magenta #FF5CB8 / #C11A79. Denied and error are pushed to clay and orange to stay distinct from it.",
    "defaultMode": "dark"
  },
  "$themeContract": "Every colour token carries a dark and a light value under one semantic name. Components read the name, never a hex. All four Troupe themes expose exactly this token set — swapping a theme swaps values only. A theme that needs a new token name is a redesign, not a theme.",
  "color": {
    "bg": {
      "stage": {
        "dark": "#0A0B0D",
        "light": "#D9DCE0"
      },
      "canvas": {
        "dark": "#101215",
        "light": "#EDEFF2"
      },
      "panel": {
        "dark": "#16191E",
        "light": "#F9FAFB"
      },
      "raised": {
        "dark": "#1D2128",
        "light": "#FFFFFF"
      },
      "sunken": {
        "dark": "#0B0D10",
        "light": "#E3E6EA"
      },
      "hover": {
        "dark": "#242931",
        "light": "#E4E8ED"
      },
      "selected": {
        "dark": "#1F2630",
        "light": "#DFE5EC"
      },
      "scrim": {
        "dark": "rgba(4,5,7,0.72)",
        "light": "rgba(14,16,19,0.44)"
      },
      "shadow": {
        "dark": "#0A0B0D",
        "light": "#D9DCE0",
        "description": "The one hard shadow: a flat block offset under a tile or a primary button. The stage colour, so it reads as depth rather than as a second colour."
      }
    },
