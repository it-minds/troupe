  "shadow": {
    "none": "none",
    "raise": {
      "dark": "0 1px 2px rgba(0,0,0,0.55)",
      "light": "0 1px 2px rgba(14,16,19,0.10)",
      "use": "Menus and chips only."
    },
    "sheet": {
      "dark": "0 -8px 28px rgba(0,0,0,0.6)",
      "light": "0 -8px 28px rgba(14,16,19,0.16)",
      "use": "Bottom sheet and mobile backstage."
    },
    "overlay": {
      "dark": "0 16px 48px rgba(0,0,0,0.68)",
      "light": "0 16px 48px rgba(14,16,19,0.22)",
      "use": "Dialogs."
    },
    "footlight": {
      "dark": "0 -1px 0 #FF5CB8, 0 -14px 34px rgba(255,92,184,0.15)",
      "light": "0 -1px 0 #C11A79, 0 -14px 34px rgba(193,26,121,0.13)",
      "use": "The approval panel only."
    }
  },
  "typography": {
    "family": {
      "sans": {
        "value": "'Figtree','Segoe UI',system-ui,sans-serif",
        "description": "Interface and reading. Geometric, with the black weights the headlines are set in, and Danish diacritics at every weight."
      },
      "mono": {
        "value": "'DM Mono',ui-monospace,Menlo,monospace",
        "description": "Anything literal — paths, commands, diffs, identifiers — and every label and pill."
      },
      "screen": {
        "value": "'VT323',monospace",
        "description": "The screen face. Section labels only, `// LIKE THIS`, and a device code. Never body text."
      }
    },
    "role": {
      "display": {
        "family": "sans",
        "size": "clamp(52px, 9vw, 96px)",
        "weight": 900,
        "lineHeight": 0.9,
        "letterSpacing": "-0.035em",
        "use": "The wordmark on the launcher, and nothing else."
      },
      "title": {
        "family": "sans",
        "size": "30px",
        "weight": 900,
        "lineHeight": 1.15,
        "letterSpacing": "-0.025em",
        "use": "Screen title."
      },
      "heading": {
        "family": "sans",
        "size": "22px",
        "weight": 900,
        "lineHeight": 1.2,
        "letterSpacing": "-0.02em",
        "use": "Session subject, approval headline."
      },
      "subheading": {
        "family": "sans",
        "size": "16px",
        "weight": 800,
        "lineHeight": 1.3,
        "letterSpacing": "0",
        "use": "Row titles, tile titles, group headings."
      },
      "body": {
        "family": "sans",
        "size": "15px",
        "weight": 400,
        "lineHeight": 1.65,
        "letterSpacing": "0",
        "use": "Conversation and all long-form reading."
      },
      "bodyStrong": {
        "family": "sans",
        "size": "15px",
        "weight": 600,
        "lineHeight": 1.65,
        "letterSpacing": "0",
        "use": "Emphasis inside body copy."
      },
      "ui": {
        "family": "sans",
        "size": "15px",
        "weight": 600,
        "lineHeight": 1.4,
        "letterSpacing": "0",
        "use": "Buttons, nav items, inputs."
      },
      "uiSmall": {
        "family": "sans",
        "size": "13px",
        "weight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0",
        "use": "The sentence under a title, secondary copy, notes."
      },
      "micro": {
        "family": "mono",
        "size": "12px",
        "weight": 500,
        "lineHeight": 1.3,
        "letterSpacing": "0.08em",
        "use": "Labels, pills, counts, relative times. Upper case and tracked: the comp's mono label."
      },
      "screen": {
        "family": "screen",
        "size": "19px",
        "weight": 400,
        "lineHeight": 1.1,
        "letterSpacing": "0.14em",
        "use": "`// SECTION` labels that name a region of a screen."
      },
      "code": {
        "family": "mono",
        "size": "13px",
        "weight": 400,
        "lineHeight": 1.55,
        "letterSpacing": "0",
        "use": "Commands, file paths, inline code, profile names."
      },
      "codeSmall": {
        "family": "mono",
        "size": "12px",
        "weight": 400,
        "lineHeight": 1.7,
        "letterSpacing": "0",
        "use": "Tool payloads and diff bodies."
      },
      "wordmark": {
        "family": "sans",
        "size": "19px",
        "weight": 900,
        "lineHeight": 1,
        "letterSpacing": "-0.02em",
        "use": "The word 'troupe' beside the mask. Always lowercase in the rail; the launcher alone sets it in capitals with the last two letters in pink."
      }
    },
    "measure": {
      "reading": {
        "value": "78ch",
        "description": "Max line length for the conversation and long copy."
      },
      "narrow": {
        "value": "46ch",
        "description": "Empty states, sign-in, error copy."
      }
    }
  },
  "space": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "22px",
    "6": "28px",
    "7": "38px",
    "8": "52px",
    "9": "72px",
    "10": "96px",
    "11": "128px",
    "px": "1px",
    "half": "2px",
    "$note": "The comp's scale runs 4, 8, 12, 16, 22, 28, 38, 52. Steps 9 to 11 continue it for the few screens that breathe more than a session does."
  },
  "radius": {
    "none": "0px",
    "xs": "0px",
    "sm": "0px",
    "md": "0px",
    "lg": "0px",
    "pill": "0px",
    "$note": "Afterglow is square. Every radius is zero; the names stay so a component that asks for one gets an answer in every theme."
  },
  "border": {
    "hairline": "1px",
    "strong": "1px",
    "focus": "2px",
    "marker": "3px",
    "heavy": "4px",
    "$note": "marker is the left edge that flags a row or panel as needing attention; heavy is the approval panel's top edge. Strong borders differ from hairlines by opacity, not by width."
  },
  "motion": {
    "duration": {
      "instant": "0ms",
      "fast": "120ms",
      "base": "180ms",
      "slow": "300ms",
      "wake": "700ms",
      "caret": "1000ms",
      "pulse": "2200ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0.05, 0.7, 0.1, 1)",
      "exit": "cubic-bezier(0.3, 0, 0.8, 0.15)",
      "linear": "linear"
    },
    "rules": [
      "Every animation is idempotent: a server-driven DOM replacement may restart it at any time, and restarting must look acceptable.",
      "Nothing animates except a state genuinely in motion: running, waiting, reconnecting, waking, and the caret while the troupe writes.",
      "A tile lifts two pixels on hover and its hard shadow grows to match. Nothing else moves.",
      "prefers-reduced-motion: reduce collapses all durations to instant and replaces pulses with static marks."
    ]
  },
  "breakpoint": {
    "min": {
      "value": "380px",
      "description": "Hard floor. Everything must work here."
    },
    "sm": {
      "value": "480px"
    },
    "md": {
      "value": "720px",
      "description": "Backstage becomes a side panel instead of a sheet."
    },
    "lg": {
      "value": "1040px",
      "description": "Session list rail appears beside the conversation."
    },
    "xl": {
      "value": "1320px",
      "description": "Reading column caps; backstage widens."
    }
  },
  "zIndex": {
    "base": 0,
    "raised": 10,
    "sticky": 100,
    "rail": 200,
    "approval": 300,
    "sheet": 400,
    "overlay": 500,
    "toast": 600
  },
  "size": {
    "touchTarget": {
      "value": "44px",
      "description": "Minimum hit area for anything tappable, approvals included."
    },
    "avatar": {
      "sm": "20px",
      "md": "26px",
      "lg": "34px"
    },
    "railWidth": "230px",
    "backstageWidth": "380px",
    "composerMinHeight": "52px",
    "switchTrack": {
      "value": "44px",
      "description": "Tool on/off switch track. Knob 18px, travel 18px."
    }
  },
  "mark": {
    "$note": "The mask. One silhouette, split down the middle: the filled half is what the agent did alone, the hollow half is what still needs a person.",
    "path": "M9 15 Q9 7 24 7 Q39 7 39 15 L39 25 Q39 35 24 43 Q9 35 9 25 Z",
    "viewBox": "0 0 48 48",
    "strokeWidth": {
      "lg": "2.6",
      "md": "3",
      "sm": "3.4"
    },
    "eyeLeft": "M15.5 21 Q19 18.4 22.5 21 Q19 23.6 15.5 21 Z",
    "eyeRight": "M25.5 21 Q29 18.4 32.5 21 Q29 23.6 25.5 21 Z",
    "seam": {
      "path": "M24 8 L24 42",
      "minSize": "32px",
      "description": "Drop the seam line below 32px and let the colour change be the seam."
    },
    "lightDirection": "right",
    "rules": [
      "Fill the mask with the surface behind it, never a colour outside the token set.",
      "No mouth, ever.",
      "An eye on a filled half is cut out of it; an eye on a hollow half is solid.",
      "People never get a mask. A human is initials in a ring."
    ]
  }
}
