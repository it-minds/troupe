{
  "name": "troupe-gui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "bench": "pnpm --filter @troupe/bench start",
    "dev": "pnpm --filter @troupe/desktop dev",
    "dev:local": "tsx scripts/dev-local.ts",
    "fake": "tsx scripts/fake-deployment.ts",
    "tokens": "tsx scripts/tokens.ts",
    "tokens:check": "tsx scripts/tokens.ts && git diff --exit-code apps/desktop/src/tokens.css apps/desktop/src/mark.ts",
    "first-token": "tsx scripts/first-token.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^5.9.2"
  }
}
