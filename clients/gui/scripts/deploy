#!/usr/bin/env bash
# Roll the GUI onto a cluster. The other half of CI, run by a person.
#
#   scripts/deploy                      # the tag in the values file
#   TAG=sha-1a2b3c4 scripts/deploy      # a specific build from CI
#   scripts/deploy --dry-run            # render and diff, change nothing
#
# CI builds and pushes; this deploys. Keeping them apart is the difference between
# merging a branch and changing production.
#
# Configuration, all overridable:
#   KUBECONFIG_FILE  where the cluster's credentials are
#   VALUES           the values file for this deployment
#   NAMESPACE        the namespace to install into
#   RELEASE          the Helm release name
#   TAG              the image tag to deploy; otherwise whatever the values file says
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
repo="$(cd "$here/.." && pwd)"
cd "$repo"

kubeconfig="${KUBECONFIG_FILE:-$repo/.local/kubeconfig.yaml}"
values="${VALUES:-$repo/.local/values.itminds.yaml}"
namespace="${NAMESPACE:-troupe-system}"
release="${RELEASE:-troupe-gui}"

if [ ! -f "$kubeconfig" ]; then
  echo "deploy: no kubeconfig at $kubeconfig — set KUBECONFIG_FILE" >&2
  exit 1
fi
if [ ! -f "$values" ]; then
  echo "deploy: no values file at $values — set VALUES" >&2
  exit 1
fi

args=(upgrade --install "$release" charts/troupe-gui
      --kubeconfig "$kubeconfig" --namespace "$namespace" --values "$values")
[ -n "${TAG:-}" ] && args+=(--set "image.tag=$TAG")

if [ "${1:-}" = "--dry-run" ]; then
  helm "${args[@]}" --dry-run
  exit 0
fi

helm "${args[@]}" --wait --timeout 5m

# What is actually running, by digest rather than by tag.
#
# This is not ceremony. A tag that already exists in the registry, plus
# `imagePullPolicy: IfNotPresent`, means the node keeps the image it has — and because
# the Deployment's spec did not change, no pod is even restarted. `helm upgrade` reports
# success and the old code carries on serving. The digest is the only thing that says
# what is there, so it is printed every time.
echo
kubectl --kubeconfig "$kubeconfig" -n "$namespace" get pods \
  -l app.kubernetes.io/instance="$release" \
  -o custom-columns='POD:.metadata.name,READY:.status.containerStatuses[0].ready,IMAGE:.status.containerStatuses[0].imageID'
