#!/usr/bin/env sh
# Run troupe from source, no Burrito build: scripts/dev [troupe args...]
#   scripts/dev                      # TUI in the current directory
#   scripts/dev run build "task" --headless --auto-approve
#   scripts/dev config
# Uses the real providers/config unless TROUPE_PROVIDER=fake is set.
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
WORKSPACE="${TROUPE_WORKSPACE:-$PWD}"
export TROUPE_CLI=1
cd "$ROOT"
exec mise exec -- mix run -- --workspace "$WORKSPACE" "$@"
