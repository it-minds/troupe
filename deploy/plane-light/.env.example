# A plane-light's settings. Copy to `.env` beside compose.yml and change what is yours;
# docs/admin/plane-light.md walks through it.

# The release every Troupe image runs: the plane, the worker and the GUI, pulled from
# ghcr.io. Change it and `up -d` again to update; the migration runs before the plane.
TROUPE_VERSION=0.32.0-beta

# The one name everything is reached by: a browser on a laptop, the clients, and the
# plane itself (which fetches the identity provider's keys at this name). On a server it
# is the box's hostname or address as the laptops reach it. On one machine for a trial,
# `plane.localtest.me` resolves to 127.0.0.1 from public DNS. Not `localhost`: inside
# the containers that is the container itself.
TROUPE_LIGHT_HOST=plane.localtest.me
# The one port published for the plane, the app, the console and the sign-in.
TROUPE_LIGHT_PORT=8080

# Where published artifacts are read: another hostname for the same box, never the one
# above, so a page somebody published runs in an origin that can reach nothing of the
# plane's. The box's IP address beside its name does; so does a second DNS name. And a
# port of its own.
TROUPE_LIGHT_ARTIFACTS_HOST=artifacts.localtest.me
TROUPE_LIGHT_ARTIFACTS_PORT=8081

# The first platform administrator, a static user in the bundled Dex. The password is
# hashed into Dex's configuration when the stack starts and is not sent anywhere else.
# More people, and a real identity provider, go in dex/config.yaml.
TROUPE_LIGHT_ADMIN_EMAIL=admin@example.test
TROUPE_LIGHT_ADMIN_PASSWORD=change-me
# The group that makes somebody a platform admin, and the group that is the one team
# the stack grants its profile to on first sign-in. The static users in dex/config.yaml
# are in both.
TROUPE_LIGHT_ADMIN_GROUP=troupe-platform-admins
TROUPE_LIGHT_TEAM_GROUP=troupe-users

# The break-glass door: a platform-admin token good for fifteen minutes at a time, which
# the stack's bootstrap uses to make the profile and register the worker, and which you
# use when the identity provider cannot let you in (the console's sign-in screen offers
# it). Long and random; whoever holds it administers the plane.
TROUPE_BREAKGLASS_TOKEN=change-me-to-something-long-and-random

# The plane's own secrets. Long and random too; nothing outside this box needs them.
TROUPE_SECRET_KEY_BASE=change-me-to-at-least-sixty-four-random-characters-0123456789abcdef
POSTGRES_PASSWORD=change-me
MINIO_ROOT_PASSWORD=change-me-too

# The model the worker's sessions call. `fake` answers from worker/fake.json and calls
# nothing, so the stack works before anybody has a key; a real one is an OpenAI-compatible
# or Anthropic endpoint, its key, and the model's name.
TROUPE_PROVIDER=fake
TROUPE_MODEL=fake
TROUPE_BASE_URL=
TROUPE_API_KEY=
# How many sessions the box runs at once.
TROUPE_LIGHT_SESSIONS=4
