#!/usr/bin/env bash
# `config/config.exs` names localhost:55432, localhost:59000 and localhost:58200 for
# Postgres, MinIO and OpenBao, because on a developer's machine `scripts/dev-up`
# publishes them there. Inside a container on the compose network the same three are
# `postgres:5432`, `minio:9000` and `openbao:8200` — so the loopback addresses the
# configuration already names are made real here, rather than by forking the
# configuration for one way of running it.
set -euo pipefail

forward() {
  socat "TCP-LISTEN:${1},fork,reuseaddr,bind=127.0.0.1" "TCP:${2}" &
}

if [ "${TROUPE_TOOLBOX_FORWARD:-1}" = "1" ]; then
  forward 55432 postgres:5432
  forward 59000 minio:9000
  forward 58200 openbao:8200

  # socat binds asynchronously, and a `mix test` that starts first sees a connection
  # refused that reads like a database which is not running.
  for port in 55432 59000 58200; do
    for _ in $(seq 100); do
      (exec 3<>"/dev/tcp/127.0.0.1/${port}") 2>/dev/null && break
      sleep 0.05
    done
  done
fi

exec "$@"
