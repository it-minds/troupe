{
  "$meta": {
    "name": "Troupe admin console design tokens",
    "version": "1.0.0",
    "description": "Design system for the Troupe platform console. Same family as the user client (ink navy, drafting blue-grey, IBM Plex) but a different instrument: status is the primary visual system, density is the default, and no single accent carries the product.",
    "themes": ["dark", "light"],
    "defaultTheme": "dark",
    "relationToClient": "Shares the ground, ink, border and person scales with tokens.json of the user client so the two products look like one platform. Diverges in three ways: the client reserves amber for 'a human must decide' — here amber means 'waiting for a safe moment'; the client's type scale starts at 15px for reading, this one starts at 13px for scanning; the client has four shadows, this one has two.",
    "statusPrinciple": "Every status token ships with a glyph and a word. Colour is the third signal, never the first. A screenshot in greyscale must still be readable."
  },

  "color": {
    "bg": {
      "stage":  { "description": "App shell, behind the rail and content.", "dark": "#070B10", "light": "#D8DFE7" },
      "canvas": { "description": "Content ground.", "dark": "#0C121A", "light": "#EDF1F5" },
      "panel":  { "description": "Tables, title blocks, forms.", "dark": "#111924", "light": "#F8FAFC" },
      "raised": { "description": "Buttons, inputs, selected rows.", "dark": "#19222F", "light": "#FFFFFF" },
      "sunken": { "description": "Code, diffs, YAML, log output, table headers.", "dark": "#090E15", "light": "#E4E9EF" },
      "hover":  { "description": "Row and control hover.", "dark": "#1E2938", "light": "#E1E8F0" },
      "selected": { "description": "Current nav item, selected row.", "dark": "#1C2A3A", "light": "#DAE4F0" },
      "scrim":  { "description": "Behind a confirmation dialog.", "dark": "rgba(3,6,10,0.72)", "light": "rgba(12,18,26,0.46)" }
    },
    "text": {
      "primary":   { "description": "Values, names, headings.", "dark": "#E7ECF3", "light": "#0D141C", "contrastOnPanel": { "dark": "14.9:1", "light": "16.4:1" } },
      "secondary": { "description": "Labels, supporting sentences.", "dark": "#AAB9C8", "light": "#3B4957", "contrastOnPanel": { "dark": "8.1:1", "light": "9.4:1" } },
      "muted":     { "description": "Units, counts, timestamps, table meta.", "dark": "#7C8DA0", "light": "#5A6977", "contrastOnPanel": { "dark": "4.7:1", "light": "5.5:1" } },
      "inverse":   { "description": "On a filled accent.", "dark": "#070B10", "light": "#FFFFFF" },
      "link":      { "dark": "#8ABFF0", "light": "#17578F" },
      "linkHover": { "dark": "#B6D9FB", "light": "#0C3A64" }
    },
    "border": {
      "hairline": { "description": "Every rule in a table, every panel edge.", "dark": "#212D3B", "light": "#C6CFDA" },
      "strong":   { "description": "Input borders, table header underline, active edges.", "dark": "#35475C", "light": "#95A5B4" },
      "focus":    { "description": "Keyboard focus ring, 3:1 on every surface it can land on.", "dark": "#8ABFF0", "light": "#0E4A7E" },
      "divider":  { "description": "Faint rule inside a panel.", "dark": "#17212D", "light": "#D5DDE5" }
    },

    "status": {
      "$shape": "Each state declares glyph (a text mark), word (the label used everywhere), and colour. Never ship one without the other two.",
      "healthy": {
        "description": "Running as configured. Nothing to do.",
        "glyph": "\u25CF", "word": "Healthy",
        "fg": { "dark": "#4CCCAD", "light": "#046855" },
        "bg": { "dark": "#0C2823", "light": "#DBF0EA" },
        "border": { "dark": "#1B5A4C", "light": "#8DCCBD" }
      },
      "degraded": {
        "description": "Still serving, below capacity or with a failing part. Action soon, not now.",
        "glyph": "\u25D0", "word": "Degraded",
        "fg": { "dark": "#FFB43D", "light": "#7A4A00" },
        "bg": { "dark": "#2C1E05", "light": "#FAEAC9" },
        "border": { "dark": "#8A5E12", "light": "#D69620" }
      },
      "broken": {
        "description": "Not serving. Something a person must fix.",
        "glyph": "\u2715", "word": "Broken",
        "fg": { "dark": "#FF7E6E", "light": "#A02112" },
        "bg": { "dark": "#2C100C", "light": "#FBDFDB" },
        "border": { "dark": "#82342A", "light": "#DE988E" }
      },
      "pending": {
        "description": "Committed by this console, not yet confirmed by the cluster.",
        "glyph": "\u25C7", "word": "Pending",
        "fg": { "dark": "#9BB8E8", "light": "#2A4E85" },
        "bg": { "dark": "#111A2A", "light": "#E2E9F6" },
        "border": { "dark": "#2E4166", "light": "#A9BBDC" }
      },
      "waiting": {
        "description": "Accepted, held until it is safe to apply. Sessions are running.",
        "glyph": "\u23F8", "word": "Waiting",
        "fg": { "dark": "#C9A9E8", "light": "#5B3487" },
        "bg": { "dark": "#1B1428", "light": "#EDE4F7" },
        "border": { "dark": "#3F2E5C", "light": "#C1A9DC" }
      },
      "draining": {
        "description": "Taken out of service, finishing what it has.",
        "glyph": "\u2193", "word": "Draining",
        "fg": { "dark": "#8FB6C9", "light": "#2E566B" },
        "bg": { "dark": "#0F1A21", "light": "#E3EBF0" },
        "border": { "dark": "#2A3F4D", "light": "#A5BAC7" }
      },
      "unknown": {
        "description": "The console has not heard from this thing. Not the same as broken.",
        "glyph": "?", "word": "Unknown",
        "fg": { "dark": "#96A5B6", "light": "#495868" },
        "bg": { "dark": "#131A22", "light": "#E6EAEF" },
        "border": { "dark": "#2B3745", "light": "#AFB9C4" }
      },
      "rejected": {
        "description": "Cluster policy refused this. The console cannot override it.",
        "glyph": "\u2298", "word": "Rejected by policy",
        "fg": { "dark": "#E6849E", "light": "#8E1F44" },
        "bg": { "dark": "#28111A", "light": "#FADFE7" },
        "border": { "dark": "#6E2E42", "light": "#DB99B0" }
      },
      "missingCredential": {
        "description": "A secret reference points at nothing. A first-class problem, not a warning.",
        "glyph": "\u2205", "word": "Credential missing",
        "fg": { "dark": "#FF9F6E", "light": "#8E3A05" },
        "bg": { "dark": "#2A1609", "light": "#FBE6D6" },
        "border": { "dark": "#7A4423", "light": "#DDA987" }
      },
      "dormant": {
        "description": "Session asleep. Costs nothing.",
        "glyph": "\u25CB", "word": "Asleep",
        "fg": { "dark": "#A79EDB", "light": "#4F4489" },
        "bg": { "dark": "#181A2B", "light": "#E7E5F4" },
        "border": { "dark": "#393B63", "light": "#B3AEDA" }
      },
      "running": {
        "description": "Session doing work right now.",
        "glyph": "\u25B8", "word": "Running",
        "fg": { "dark": "#4CCCAD", "light": "#046855" },
        "bg": { "dark": "#0C2823", "light": "#DBF0EA" },
        "border": { "dark": "#1B5A4C", "light": "#8DCCBD" }
      },
      "disconnected": {
        "description": "The console lost the cluster. Sessions are unaffected — say so.",
        "glyph": "\u26A1", "word": "Console offline",
        "fg": { "dark": "#C6B08A", "light": "#5D4820" },
        "bg": { "dark": "#1F1A10", "light": "#EEE7D7" },
        "border": { "dark": "#4C4026", "light": "#C1B190" }
      }
    },

    "budget": {
      "under":   { "description": "Below 80% of budget.", "dark": "#4CCCAD", "light": "#046855" },
      "near":    { "description": "80–100%.", "dark": "#FFB43D", "light": "#7A4A00" },
      "over":    { "description": "Above budget.", "dark": "#FF7E6E", "light": "#A02112" },
      "trackBg": { "dark": "#0A1119", "light": "#DCE3EB" }
    },

    "diff": {
      "addedBg":     { "dark": "#0C2317", "light": "#DEF2E3" },
      "addedText":   { "dark": "#8EDFAB", "light": "#0D5A2B" },
      "addedMarker": { "dark": "#2E7A4D", "light": "#2B8A4F" },
      "removedBg":   { "dark": "#29120F", "light": "#FAE1DC" },
      "removedText": { "dark": "#F4A699", "light": "#8A2B17" },
      "removedMarker": { "dark": "#8B3D30", "light": "#B44A32" },
      "contextText": { "dark": "#899AAB", "light": "#4D5B69" },
      "gutterBg":    { "dark": "#090F17", "light": "#E0E6ED" },
      "gutterText":  { "dark": "#5E7085", "light": "#667488" },
      "hunkHeader":  { "dark": "#7C8DA0", "light": "#53627A" }
    },

    "table": {
      "headerBg":    { "dark": "#090E15", "light": "#E4E9EF" },
      "headerText":  { "dark": "#9AA9BA", "light": "#41505F" },
      "rowBorder":   { "dark": "#182230", "light": "#DCE3EB" },
      "rowHover":    { "dark": "#1E2938", "light": "#E1E8F0" },
      "rowSelected": { "dark": "#1C2A3A", "light": "#DAE4F0" },
      "numeric":     { "description": "Numbers are mono, tabular, right-aligned.", "fontVariant": "tabular-nums" },
      "changedCell": { "description": "A value that just changed under the reader.", "dark": "#1F2C1F", "light": "#E3F0DF" }
    }
  },

  "typography": {
    "family": {
      "sans": { "value": "'IBM Plex Sans','Segoe UI',system-ui,sans-serif", "description": "Prose, labels, headings." },
      "mono": { "value": "'IBM Plex Mono',ui-monospace,'SFMono-Regular',Menlo,monospace", "description": "All platform data: identifiers, endpoints, versions, amounts, timestamps, status glyphs, diffs, YAML." }
    },
    "role": {
      "pageTitle":   { "family": "sans", "size": "21px", "weight": 600, "lineHeight": 1.25, "letterSpacing": "-0.012em" },
      "sectionTitle":{ "family": "sans", "size": "15px", "weight": 600, "lineHeight": 1.35, "letterSpacing": "-0.004em" },
      "panelTitle":  { "family": "sans", "size": "13px", "weight": 600, "lineHeight": 1.35, "letterSpacing": "0" },
      "body":        { "family": "sans", "size": "13px", "weight": 400, "lineHeight": 1.55, "letterSpacing": "0.003em", "use": "Explanatory sentences. Max 76ch." },
      "ui":          { "family": "sans", "size": "13px", "weight": 500, "lineHeight": 1.35, "letterSpacing": "0.004em", "use": "Buttons, nav, tabs." },
      "label":       { "family": "sans", "size": "12px", "weight": 500, "lineHeight": 1.3, "letterSpacing": "0.006em", "use": "Field labels in title blocks and forms. Sentence case." },
      "data":        { "family": "mono", "size": "12.5px", "weight": 400, "lineHeight": 1.45, "letterSpacing": "0", "use": "Table cells, identifiers, endpoints." },
      "dataStrong":  { "family": "mono", "size": "12.5px", "weight": 600, "lineHeight": 1.45, "letterSpacing": "0" },
      "micro":       { "family": "mono", "size": "11px", "weight": 500, "lineHeight": 1.3, "letterSpacing": "0.03em", "use": "Status words, column headers, counts. Sentence case, never all caps." },
      "code":        { "family": "mono", "size": "12px", "weight": 400, "lineHeight": 1.5, "letterSpacing": "0", "use": "YAML, diffs, commands, log lines." },
      "metric":      { "family": "mono", "size": "22px", "weight": 600, "lineHeight": 1.15, "letterSpacing": "-0.01em", "use": "The four numbers on Overview. Nothing else." }
    },
    "measure": { "prose": "76ch", "narrow": "52ch" }
  },

  "space": {
    "0": "0px", "px": "1px", "half": "2px",
    "1": "4px", "2": "6px", "3": "8px", "4": "12px", "5": "16px",
    "6": "20px", "7": "24px", "8": "32px", "9": "40px", "10": "56px", "11": "72px",
    "$note": "Denser than the client's scale. 6px exists because table padding needs it."
  },

  "density": {
    "rowHeight":      { "value": "32px", "description": "Default table row. Forty rows visible on a laptop." },
    "rowHeightRoomy": { "value": "40px", "description": "Rows carrying two lines, e.g. name over identifier." },
    "cellPaddingX":   "10px",
    "cellPaddingY":   "6px",
    "controlHeight":  "30px",
    "controlHeightTouch": { "value": "44px", "description": "Minimum on any viewport where coarse pointer is likely, and on every destructive action at any size." },
    "fieldGap":       "12px",
    "titleBlockRow":  "28px"
  },

  "radius": { "none": "0px", "xs": "2px", "sm": "3px", "md": "4px", "lg": "6px", "pill": "999px",
    "$note": "Tighter than the client. A control room is ruled, not rounded." },

  "border": { "hairline": "1px", "strong": "1.5px", "focus": "2px", "marker": "3px",
    "$note": "marker is the left edge that carries a status on a row or panel." },

  "shadow": {
    "none": "none",
    "raise":   { "dark": "0 1px 2px rgba(0,0,0,0.55)", "light": "0 1px 2px rgba(12,18,26,0.10)", "use": "Menus and popovers only." },
    "overlay": { "dark": "0 18px 50px rgba(0,0,0,0.66)", "light": "0 18px 50px rgba(12,18,26,0.24)", "use": "Confirmation dialogs only." },
    "$note": "Two shadows, both functional. Panels and tables are separated by hairlines, never by elevation."
  },

  "motion": {
    "duration": { "instant": "0ms", "fast": "100ms", "base": "160ms", "slow": "260ms", "settle": "1800ms", "pulse": "2400ms" },
    "easing": { "standard": "cubic-bezier(0.2,0,0,1)", "enter": "cubic-bezier(0.05,0.7,0.1,1)", "linear": "linear" },
    "rules": [
      "settle is the fade-out of the changed-cell highlight after a live update. It is the only animation that carries meaning, and the value is also re-announced to assistive tech.",
      "Nothing pulses except a state that is genuinely in motion: pending, draining, reconnecting.",
      "Every animation must survive being restarted by a server-driven DOM replacement.",
      "prefers-reduced-motion: reduce removes pulses and the settle fade; changed cells then hold a static left marker for one refresh."
    ]
  },

  "breakpoint": {
    "min": { "value": "360px", "description": "Checking-in mode only: overview, status lists, session list." },
    "sm":  { "value": "600px" },
    "md":  { "value": "900px", "description": "Tables gain their secondary columns." },
    "lg":  { "value": "1200px", "description": "Nav rail becomes a permanent column." },
    "xl":  { "value": "1600px", "description": "Detail screens split into two columns." }
  },

  "zIndex": { "base": 0, "raised": 10, "stickyHeader": 100, "rail": 200, "popover": 300, "dialog": 400, "toast": 500 },

  "size": {
    "railWidth": "216px",
    "contentMax": "1480px",
    "glyphColumn": { "value": "16px", "description": "Fixed column for the status glyph so glyphs align down a table." }
  }
}
