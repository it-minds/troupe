#!/usr/bin/env bash
# Build the Burrito binary for this host only.
#
# Cross-building the macOS or Windows targets from here would bundle a Linux .so for
# the ExRatatui NIF — rustler_precompiled resolves the NIF against the *build host* —
# so the other four targets are produced by the CI matrix on native runners. This is
# the development loop.
set -euo pipefail

cd "$(dirname "$0")/.."

require() {
  command -v "$1" >/dev/null 2>&1 || { echo "build-local: $1 is required but not on PATH" >&2; exit 1; }
}
require zig
require xz

expected_zig="0.16.0"
actual_zig="$(zig version)"
if [ "$actual_zig" != "$expected_zig" ]; then
  echo "build-local: Burrito 1.6 hard-pins Zig $expected_zig, found $actual_zig" >&2
  exit 1
fi

host_target() {
  local arch
  arch="$(uname -m)"
  case "$arch" in
    aarch64|arm64) arch="aarch64" ;;
    *) arch="x86_64" ;;
  esac

  case "$(uname -s)" in
    Darwin) echo "macos_${arch}" ;;
    Linux) echo "linux_${arch}" ;;
    MINGW*|MSYS*|CYGWIN*) echo "windows_x86_64" ;;
    *) echo "linux_${arch}" ;;
  esac
}

target="${BURRITO_TARGET:-$(host_target)}"

# Zig 0.16 uses renameat2 with flags that ecryptfs and some network filesystems
# reject with EINVAL, which it treats as a programmer bug and aborts on. Keeping its
# caches on a plain local filesystem sidesteps that; harmless everywhere else.
cache_root="${TMPDIR:-/tmp}/troupe-zig-cache"
mkdir -p "$cache_root/local" "$cache_root/global"
export ZIG_LOCAL_CACHE_DIR="$cache_root/local"
export ZIG_GLOBAL_CACHE_DIR="$cache_root/global"

# The Linux wrapper carries a musl ERTS, so the bundled NIF must be the musl variant.
case "$target" in
  linux_*) export TARGET_ABI=musl ;;
esac

# A locally built crate ignores TARGET_ABI and links against the host's libc, which
# would defeat the check above.
unset EX_RATATUI_BUILD || true

export MIX_ENV=prod
export BURRITO_TARGET="$target"
export TROUPE_REAPER_TARGETS=all

echo "build-local: building $target"
mix deps.get
mix release --overwrite

version="$(mix run --no-start -e 'IO.write(Mix.Project.config()[:version])' 2>/dev/null || echo dev)"
built="burrito_out/troupe_${target}"
suffix=""
case "$target" in windows_*) suffix=".exe" ;; esac

# Burrito caches the extracted payload under <app>_erts-<erts>_<version>, so a
# rebuild that does not change `version:` re-runs the *cached* copy — which silently
# hides every change made since the last version bump.
clear_payload_cache() {
  case "$(uname -s)" in
    Darwin) cache="$HOME/Library/Application Support/.burrito" ;;
    *) cache="${XDG_DATA_HOME:-$HOME/.local/share}/.burrito" ;;
  esac
  find "$cache" -maxdepth 1 -name 'troupe_erts-*' -exec rm -rf {} + 2>/dev/null || true
}
clear_payload_cache

if [ -f "${built}${suffix}" ]; then
  final="burrito_out/troupe-${version}-${target}${suffix}"
  mv "${built}${suffix}" "$final"
  chmod +x "$final"
  echo "build-local: wrote $final ($(du -h "$final" | cut -f1))"
else
  echo "build-local: expected ${built}${suffix} but it is missing" >&2
  exit 1
fi
