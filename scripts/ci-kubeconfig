#!/usr/bin/env bash
# Print a kubeconfig for the CI deployer, on stdout.
#
#   scripts/ci-kubeconfig > .local/kubeconfig.ci.yaml
#
# Why this exists rather than reusing the one a person has: Scaleway issues a kubeconfig
# whose user is an *exec plugin*, which shells out to `scw` on the machine using it. A
# runner has no `scw`, so it fails with "executable scw not found" — and the token it
# would have minted is that person's cluster-admin one anyway. This reads the token of
# the `troupe-deployer` service account (deploy/ci-deployer.yaml) and writes a
# kubeconfig with the token *in* it, so it carries no dependency on anything installed.
#
# The output is a credential. It goes to `.local/`, which is gitignored, and from there
# into the `production` environment's `KUBECONFIG` secret. It is never committed and never printed
# into a log.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
repo="$(cd "$here/.." && pwd)"

kubeconfig="${KUBECONFIG_FILE:-$repo/.local/kubeconfig.yaml}"
namespace="${NAMESPACE:-troupe-system}"
account="${ACCOUNT:-troupe-deployer}"

if [ ! -f "$kubeconfig" ]; then
  echo "ci-kubeconfig: no kubeconfig at $kubeconfig — set KUBECONFIG_FILE" >&2
  exit 1
fi

kube() { kubectl --kubeconfig "$kubeconfig" -n "$namespace" "$@"; }

# The token Secret is populated by a controller, not by `kubectl apply`, so a run
# immediately after applying the manifest can find it empty. Worth waiting a moment for
# rather than emitting a kubeconfig with no credential in it.
token=""
for _ in $(seq 1 20); do
  token="$(kube get secret "$account" -o jsonpath='{.data.token}' 2>/dev/null || true)"
  [ -n "$token" ] && break
  sleep 1
done

if [ -z "$token" ]; then
  echo "ci-kubeconfig: the $account token secret is empty. Is deploy/ci-deployer.yaml applied?" >&2
  exit 1
fi

token="$(printf '%s' "$token" | base64 -d)"

# The cluster's address and CA come from the working kubeconfig: they are the same
# cluster, and only the *user* is being replaced.
server="$(kubectl --kubeconfig "$kubeconfig" config view --minify --raw -o jsonpath='{.clusters[0].cluster.server}')"
ca="$(kubectl --kubeconfig "$kubeconfig" config view --minify --raw -o jsonpath='{.clusters[0].cluster.certificate-authority-data}')"

# Fall back to the CA the service account was handed, for a kubeconfig that referenced a
# CA file rather than embedding one.
if [ -z "$ca" ]; then
  ca="$(kube get secret "$account" -o jsonpath='{.data.ca\.crt}')"
fi

cat <<YAML
apiVersion: v1
kind: Config
clusters:
  - name: troupe
    cluster:
      server: ${server}
      certificate-authority-data: ${ca}
users:
  - name: ${account}
    user:
      token: ${token}
contexts:
  - name: ${account}@troupe
    context:
      cluster: troupe
      namespace: ${namespace}
      user: ${account}
current-context: ${account}@troupe
YAML
