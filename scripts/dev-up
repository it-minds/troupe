#!/usr/bin/env bash
# Bring up the services the plane and workers talk to.
#
# Named `troupe-dev` and on its own ports, so a machine that already runs a Postgres or
# a MinIO does not notice this one.
set -euo pipefail

cd "$(dirname "$0")/.."

compose() { docker compose --project-directory dev --file dev/docker-compose.yml "$@"; }

# Only the three that stay up are waited on. `--wait` fails the moment any container
# it is watching exits, and the two setup services are one-shots that exit 0 on
# purpose - so they are run afterwards, once their service is healthy, and their exit
# codes are what `set -e` reads.
compose up --detach --wait --wait-timeout 180 postgres minio openbao

# A bucket with versioning on, and the transit engine and signing key the plane mints
# session tokens through. Neither is optional: erasure has to destroy prior versions,
# and a plane with no key cannot sign.
compose run --rm --no-deps minio-setup
compose run --rm --no-deps openbao-setup

echo
echo "postgres  postgres://troupe:troupe@localhost:55432/troupe_plane_dev"
echo "minio     http://localhost:59000  (console :59001, troupe / troupe-secret)"
echo "openbao   http://localhost:58200  (dev root token: troupe-dev-root)"
