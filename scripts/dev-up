#!/usr/bin/env bash
# Bring up the services the plane and workers talk to.
#
# Named `troupe-dev` and on its own ports, so a machine that already runs a Postgres or
# a MinIO does not notice this one.
set -euo pipefail

cd "$(dirname "$0")/.."

compose() { docker compose --project-directory dev --file dev/docker-compose.yml "$@"; }

# Only the three that stay up are waited on. `--wait` fails the moment any container
# it is watching exits, and the setup service is a one-shot that exits 0 on purpose -
# so it is run afterwards, once MinIO is healthy, and its exit code is what `set -e`
# reads. OpenBao seeds its own transit engine and key, and is not healthy until it has.
compose up --detach --wait --wait-timeout 180 postgres minio openbao

# A bucket with versioning on: erasure has to destroy prior versions.
compose run --rm --no-deps minio-setup

echo
echo "postgres  postgres://troupe:troupe@localhost:25432/troupe_plane_dev"
echo "minio     http://localhost:29000  (console :29001, troupe / troupe-secret)"
echo "openbao   http://localhost:28200  (dev root token: troupe-dev-root)"
