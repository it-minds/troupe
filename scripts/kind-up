#!/usr/bin/env bash
# A local Kubernetes cluster for the operator and the plane.
#
# Named `troupe-dev` and given its own ports on purpose: a developer's machine
# usually has other things in Docker, and none of them should notice this.
set -euo pipefail

# The cluster definition is a file in this repository, shared with CI, so `--config`
# below is relative to the root and not to wherever this was run from.
cd "$(dirname "$0")/.."

cluster="${TROUPE_KIND_CLUSTER:-troupe-dev}"

command -v kind >/dev/null || { echo "kind-up: kind is required" >&2; exit 1; }
command -v kubectl >/dev/null || { echo "kind-up: kubectl is required" >&2; exit 1; }

if kind get clusters 2>/dev/null | grep -qx "$cluster"; then
  echo "kind-up: $cluster already exists"
else
  # Which CNI, and it is a choice with a consequence.
  #
  # `cilium` is the default and is what the product is written for: kind's own CNI
  # implements pod networking and ignores every NetworkPolicy, so an egress rule on such
  # a cluster is enforced by nothing at all. `mix troupe.e2e` fails its egress claim on a
  # cluster that does not enforce — deliberately, and whichever CNI is at fault — so a
  # fallback can never be mistaken for a passing one.
  #
  # `default` exists because some kernels cannot carry Cilium's datapath. Under Docker
  # Desktop it starts, reports policy enforcement it is not performing, does not implement
  # `hostPort` without kube-proxy replacement, and disrupts long-lived pod-to-pod TCP. A
  # developer there is better served by a cluster that is honest about enforcing nothing
  # than by one that says it does.
  case "${TROUPE_KIND_CNI:-cilium}" in
    cilium)
      # No `--wait`: with no CNI the node stays NotReady until `scripts/remote-up`
      # installs one, so waiting for readiness here waits for something this script
      # does not do.
      {
        cat dev/kind/cluster.yaml
        printf '%s
' 'networking:' '  disableDefaultCNI: true'
      } | kind create cluster --name "$cluster" --config -
      echo "kind-up: no CNI yet; the node is NotReady until scripts/remote-up installs Cilium"
      ;;
    default)
      kind create cluster --name "$cluster" --wait 120s --config dev/kind/cluster.yaml
      echo "kind-up: using kind's own CNI, which enforces no NetworkPolicy at all" >&2
      ;;
    *)
      echo "kind-up: TROUPE_KIND_CNI is 'cilium' or 'default'" >&2
      exit 1
      ;;
  esac
fi

# Worker pods run in a user namespace of their own (`worker.userNamespaces`), and two
# things about a kind node stop such a pod from starting at all.
#
# - The runtime runs kind's createContainer hook, /kind/bin/mount-product-files.sh, inside
#   the pod's user namespace, as its root, which is nobody on the node. The node image
#   leaves /kind at 0644, so that root cannot reach it ("fork/exec
#   /kind/bin/mount-product-files.sh: permission denied"). Nothing under /kind is secret.
# - The pod gets a sysfs of its own, and the kernel mounts one in a user namespace only
#   where an existing sysfs is fully visible. kind mounts files over the node's own
#   (/sys/class/dmi/id/product_uuid and the rest), so on a host with DMI it is not, and the
#   pod's sandbox fails ('error mounting "sysfs" to rootfs at "/sys": ... operation not
#   permitted'). A second sysfs, read-only, with nothing over it, is one. Not kept across
#   a restart of the node: this script puts it back.
for node in $(kind get nodes --name "$cluster"); do
  docker exec "$node" chmod 0755 /kind
  docker exec "$node" sh -c 'mountpoint -q /mnt/sysfs ||
    { mkdir -p /mnt/sysfs && mount -t sysfs -o ro,nosuid,nodev,noexec sysfs /mnt/sysfs; }'
done

kubectl --context "kind-${cluster}" version --output=yaml | head -20
kubectl --context "kind-${cluster}" get nodes
