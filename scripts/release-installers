#!/usr/bin/env bash
# The installers as a release attaches them: install.sh and install.ps1 from this checkout,
# with the release's version written in, so the copy on a release page installs that
# release -- a release candidate or a pre-release included, which /releases/latest never
# names -- without TROUPE_VERSION. They are attached with the rest and so land in the
# release's SHA256SUMS.
#
# The release key is written in too: the first key in apps/troupe_core/priv/release-keys.txt,
# the one the release's manifest is signed with, which the installers check that signature
# against when minisign is installed (Decision 865). With no key in the list yet, they carry
# none, and say they can check SHA256SUMS only.
#
#   scripts/release-installers VERSION OUTDIR
set -euo pipefail

version=${1:?usage: scripts/release-installers VERSION OUTDIR}
out=${2:?usage: scripts/release-installers VERSION OUTDIR}
root=$(cd "$(dirname "$0")/.." && pwd)

case "$version" in
  *[!0-9A-Za-z.-]* | "") echo "error: $version is not a version" >&2; exit 1 ;;
esac

key=$(grep -v '^[[:space:]]*#' "$root/apps/troupe_core/priv/release-keys.txt" | tr -d '[:space:]' | head -c 56 || true)
case "$key" in
  "") ;;
  RW*) [ "${#key}" = 56 ] || { echo "error: the first key in release-keys.txt is not a minisign public key" >&2; exit 1; } ;;
  *) echo "error: the first key in release-keys.txt is not a minisign public key" >&2; exit 1 ;;
esac

mkdir -p "$out"
sed -e "s/^PINNED_VERSION=\"\"/PINNED_VERSION=\"${version}\"/" \
  -e "s|^RELEASE_KEY=\"\"|RELEASE_KEY=\"${key}\"|" "$root/install.sh" > "$out/install.sh"
sed -e "s/^\\\$PinnedVersion = \"\"/\$PinnedVersion = \"${version}\"/" \
  -e "s|^\\\$ReleaseKey = \"\"|\$ReleaseKey = \"${key}\"|" "$root/install.ps1" > "$out/install.ps1"

# A line that no longer matches would publish installers that install the latest release,
# or that check no signature.
grep -qx "PINNED_VERSION=\"${version}\"" "$out/install.sh" || { echo "error: could not pin install.sh to $version" >&2; exit 1; }
grep -qxF "\$PinnedVersion = \"${version}\"" "$out/install.ps1" || { echo "error: could not pin install.ps1 to $version" >&2; exit 1; }
grep -qxF "RELEASE_KEY=\"${key}\"" "$out/install.sh" || { echo "error: could not write the release key into install.sh" >&2; exit 1; }
grep -qxF "\$ReleaseKey = \"${key}\"" "$out/install.ps1" || { echo "error: could not write the release key into install.ps1" >&2; exit 1; }
if [ -n "$key" ]; then
  echo "installers pinned to $version, with release key $key, in $out"
else
  echo "installers pinned to $version in $out (no release key yet: they check SHA256SUMS only)"
fi
