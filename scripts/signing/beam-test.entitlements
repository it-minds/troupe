<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The signing test's entitlements, never a release's: beam.entitlements, and
  `disable-library-validation`, because the test's self-signed or ad hoc signature has no
  team, and library validation lets a program load only libraries of its own team. A
  Developer ID signature has one, the same on every file, and needs no such entitlement.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
